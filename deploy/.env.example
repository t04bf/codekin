# Docker Compose 开发环境统一密码；首次初始化后的持久化密码不会随此值自动变更。
CODEKIN_DEV_PASSWORD=Wcb123123

# SeaweedFS 的 S3 访问凭据与管理后台登录分别配置；仅用于本地开发。
CODEKIN_STORAGE_ACCESS_KEY=codekin
CODEKIN_STORAGE_SECRET_KEY=Wcb123123
CODEKIN_STORAGE_BUCKET=codekin
CODEKIN_SEAWEEDFS_ADMIN_USER=codekin
CODEKIN_SEAWEEDFS_ADMIN_PASSWORD=Wcb123123
# 后续 Java S3 客户端使用；容器内访问时 endpoint 应改为 http://seaweedfs:8333。
CODEKIN_STORAGE_ENDPOINT=http://127.0.0.1:8333
CODEKIN_STORAGE_REGION=us-east-1
# 浏览器必须可达，签名后不能替换 host；部署到其他机器时改为实际可达域名。
CODEKIN_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:8333
CODEKIN_STORAGE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
CODEKIN_FILE_PORT=8083
CODEKIN_DUBBO_HOST=127.0.0.1
CODEKIN_FILE_DUBBO_PORT=20883
# 内部文件 RPC 独立随机 token，文件服务的运行环境必填，不使用开发密码。
CODEKIN_DUBBO_FILE_TOKEN=

# Nacos 服务端密钥与内部身份必须分别使用独立随机值；不可填写上述登录密码。
CODEKIN_NACOS_AUTH_TOKEN=
CODEKIN_NACOS_IDENTITY_KEY=
CODEKIN_NACOS_IDENTITY_VALUE=

# 下列变量由后端 Java 进程使用，不由此 Compose 启动应用容器。
CODEKIN_NACOS_SERVER_ADDR=127.0.0.1:8848
CODEKIN_NACOS_DISCOVERY_IP=127.0.0.1
CODEKIN_NACOS_USERNAME=nacos
CODEKIN_NACOS_PASSWORD=Wcb123123
CODEKIN_MYSQL_HOST=127.0.0.1
CODEKIN_MYSQL_PORT=3306
CODEKIN_MYSQL_DATABASE=codekin
CODEKIN_MYSQL_USER=codekin
CODEKIN_MYSQL_PASSWORD=Wcb123123
CODEKIN_REDIS_HOST=127.0.0.1
CODEKIN_REDIS_PORT=6379
CODEKIN_REDIS_USERNAME=default
CODEKIN_REDIS_PASSWORD=Wcb123123
CODEKIN_GATEWAY_PORT=8080
CODEKIN_USER_PORT=8081
CODEKIN_CONTENT_PORT=8084
CODEKIN_RESUME_PORT=8085
CODEKIN_RESUME_PDF_ASSETS_DIRECTORY=
CODEKIN_RESUME_PDF_EXECUTABLE_PATH=
CODEKIN_RESUME_PDF_TIMEOUT_MILLIS=30000
CODEKIN_RESUME_PDF_MAX_CONCURRENT=2
CODEKIN_JWT_SECRET_BASE64=
CODEKIN_GATEWAY_CONTEXT_SECRET_BASE64=
# DIRECT 直连；TRUSTED_PROXY 需要填写实际代理的 IP/CIDR，多个值用逗号分隔。
CODEKIN_GATEWAY_CLIENT_IP_MODE=DIRECT
CODEKIN_GATEWAY_TRUSTED_PROXY_CIDRS=
CODEKIN_SMS_REGION=cn-shenzhen
# 阿里云号码认证短信签名和模板编号；由发送请求传给 SDK。
CODEKIN_SMS_SIGN_NAME=
CODEKIN_SMS_TEMPLATE_CODE=
CODEKIN_SMS_CODE_HASH_SECRET=
# 异步 SDK 从这两个环境变量读取阿里云 AccessKey。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# 网易个人邮箱需在网页端开启 SMTP，并在本机填写邮箱及 SMTP 授权码。
CODEKIN_MAIL_HOST=smtp.163.com
CODEKIN_MAIL_PORT=465
CODEKIN_MAIL_USERNAME=
CODEKIN_MAIL_AUTH_CODE=
# 独立的至少 32 字节随机字符串；所有用户服务实例保持一致。
CODEKIN_EMAIL_CODE_HASH_SECRET=
